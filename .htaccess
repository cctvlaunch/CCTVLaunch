# Enable mod_rewrite
RewriteEngine On

# --------------------------------------------------------
# 1. Force HTTPS and remove www (https://www.example.com → https://example.com)
# --------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://cctvlaunch.com.au%{REQUEST_URI} [R=301,L]

# --------------------------------------------------------
# 2. Remove trailing slashes (except for directories and root)
# --------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# --------------------------------------------------------
# 3. Redirect .html URLs to clean versions (/about.html → /about)
# --------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# --------------------------------------------------------
# 4. Internally rewrite clean URLs to .html files (so /about serves about.html)
# --------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# --------------------------------------------------------
# 5. Custom 404 page
# --------------------------------------------------------
ErrorDocument 404 /404.html
