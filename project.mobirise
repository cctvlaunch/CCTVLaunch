          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "deltapi-code-editor",
          "_isSecondary": true,
          "_styles": {
            ".calc-wrapper": {
              "font-family": "Arial, sans-serif",
              "padding": "20px",
              "max-width": "800px",
              "margin": "auto",
              "background": "#fff",
              "color": "#000"
            },
            ".calc-title": {
              "text-align": "center",
              "font-size": "24px",
              "margin-bottom": "30px"
            },
            ".calc-row": {
              "display": "flex",
              "justify-content": "space-between",
              "flex-wrap": "wrap",
              "margin-bottom": "20px"
            },
            ".calc-field": {
              "flex": "1 1 45%",
              "display": "flex",
              "flex-direction": "column",
              "margin-bottom": "10px",
              "margin-left": "10px",
              "margin-right": "10px"
            },
            ".calc-field label": {
              "font-weight": "bold",
              "margin-bottom": "5px"
            },
            ".calc-field input": {
              "padding": "10px",
              "font-size": "16px",
              "border": "3px solid #f60",
              "border-radius": "4px"
            },
            ".calc-field input.readonly, .calc-subfield input.readonly": {
              "border-color": "#000",
              "background-color": "#f5f5f5"
            },
            ".calc-split": {
              "display": "flex",
              "gap": "20px",
              "margin-top": "30px",
              "flex-wrap": "wrap"
            },
            ".calc-box": {
              "flex": "1 1 45%",
              "border": "2px solid #000",
              "padding": "20px"
            },
            ".calc-subfield label": {
              "display": "block",
              "margin-top": "10px",
              "font-weight": "bold"
            },
            ".calc-subfield input": {
              "width": "100%",
              "padding": "10px",
              "font-size": "16px",
              "border": "3px solid #f60",
              "border-radius": "4px"
            },
            ".calc-heading": {
              "font-weight": "bold",
              "color": "#f60",
              "margin-bottom": "10px",
              "font-size": "18px"
            },
            ".calc-summary": {
              "margin-top": "30px",
              "font-size": "18px",
              "line-height": "1.6"
            }
          },
          "_name": "custom-html",
          "_sourceTheme": "startm5",
          "_customHTML": "<section>\n\n   <!-- HTML for Mobirise Calculator -->\n<div class=\"calc-wrapper\">\n\n\n  <!-- Input Rows -->\n  <div class=\"calc-row\">\n    <div class=\"calc-field\">\n      <label>Ad Spend (Monthly)</label>\n      <input type=\"number\" id=\"adSpend\">\n    </div>\n    <div class=\"calc-field\">\n      <label>Total Leads</label>\n      <input type=\"number\" id=\"totalLeads\">\n    </div>\n  </div>\n  <div class=\"calc-row\">\n\n    <div class=\"calc-field\">\n      <label>Average Invoice</label>\n      <input type=\"number\" id=\"avgInvoice\">\n    </div>\n    <div class=\"calc-field\">\n      <label>Agency Charge (Monthly)</label>\n      <input type=\"number\" id=\"agencyCharge\">\n    </div>\n  </div>\n  <div class=\"calc-row\">\n    <div class=\"calc-field\">\n      <label>Close Rate (%)</label>\n      <input type=\"number\" id=\"closeRate\">\n    </div>\n    <div class=\"calc-field\">\n      <label>Jobs Closed</label>\n      <input type=\"number\" id=\"jobsClosed\" class=\"readonly\" readonly>\n    </div>\n  </div>\n\n  <!-- Output Rows -->\n  <div class=\"calc-row\">\n    <div class=\"calc-field\">\n      <label>CPL (Cost Per Lead)</label>\n      <input type=\"number\" id=\"cpl\" class=\"readonly\" readonly>\n    </div>\n    <div class=\"calc-field\">\n      <label>CPA (Cost Per Acquisition)</label>\n      <input type=\"number\" id=\"cpa\" class=\"readonly\" readonly>\n    </div>\n  </div>\n\n  <!-- Monthly / Yearly Revenue Section -->\n  <div class=\"calc-split\">\n    <div class=\"calc-box\">\n      <div class=\"calc-subfield\">\n        <div class=\"calc-heading\">Monthly</div>\n        <label>Revenue</label>\n        <input type=\"number\" id=\"monthlyRevenue\" class=\"readonly\" readonly>\n        <label>Agency Charge</label>\n        <input type=\"number\" id=\"monthlyAgency\" class=\"readonly\" readonly>\n      </div>\n    </div>\n    <div class=\"calc-box\">\n      <div class=\"calc-subfield\">\n        <div class=\"calc-heading\">Yearly</div>\n        <label>Revenue</label>\n        <input type=\"number\" id=\"yearlyRevenue\" class=\"readonly\" readonly>\n        <label>Agency Charge</label>\n        <input type=\"number\" id=\"yearlyAgency\" class=\"readonly\" readonly>\n      </div>\n    </div>\n  </div>\n\n  <!-- Summary -->\n  <div class=\"calc-summary\" id=\"summaryText\"></div>\n</div>\n\n<!-- JS to Make It Work -->\n<script>\n  function calculate() {\n    const adSpend = parseFloat(document.getElementById('adSpend').value);\n    const totalLeads = parseFloat(document.getElementById('totalLeads').value);\n    const avgInvoice = parseFloat(document.getElementById('avgInvoice').value);\n    const agencyCharge = parseFloat(document.getElementById('agencyCharge').value);\n    const closeRatePercent = parseFloat(document.getElementById('closeRate').value);\n\n    if (isNaN(adSpend) || isNaN(totalLeads) || isNaN(avgInvoice) || isNaN(agencyCharge) || isNaN(closeRatePercent)) {\n      document.getElementById('summaryText').innerHTML = '';\n      return;\n    }\n\n    const closeRate = closeRatePercent / 100;\n    const jobsClosed = totalLeads * closeRate;\n    const cpl = adSpend / totalLeads;\n    const cpa = jobsClosed > 0 ? adSpend / jobsClosed : 0;\n    const revenue = jobsClosed * avgInvoice;\n    const yearlyRevenue = revenue * 12;\n    const yearlyAgency = agencyCharge * 12;\n    const roi = (adSpend * 12) > 0 ? (yearlyRevenue / (adSpend * 12)) : 0;\n\n    document.getElementById('jobsClosed').value = jobsClosed.toFixed(0);\n    document.getElementById('cpl').value = cpl.toFixed(2);\n    document.getElementById('cpa').value = cpa.toFixed(2);\n    document.getElementById('monthlyRevenue').value = revenue.toFixed(2);\n    document.getElementById('monthlyAgency').value = agencyCharge.toFixed(2);\n    document.getElementById('yearlyRevenue').value = yearlyRevenue.toFixed(2);\n    document.getElementById('yearlyAgency').value = yearlyAgency.toFixed(2);\n\n    document.getElementById('summaryText').innerHTML = `\n      By investing <strong>$${adSpend.toFixed(2)}</strong>/month, you can potentially add <strong>$${yearlyRevenue.toFixed(2)}</strong>/year.<br>\n      Your ROI is <strong>${roi.toFixed(2)}x</strong>.\n    `;\n  }\n\n  document.querySelectorAll('input').forEach(input => input.addEventListener('input', calculate));\n</script>\n\n</section>",
          "_cid": "uQPNjKSrs7",
          "_anchor": "custom-html-fl",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
